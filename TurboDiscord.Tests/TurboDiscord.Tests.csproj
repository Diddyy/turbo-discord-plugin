<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Orleans.Core.Abstractions" />
    <PackageReference Include="Microsoft.Orleans.Serialization.Abstractions" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TurboDiscord\TurboDiscord.csproj" />
  </ItemGroup>
  <!-- Here the host's assemblies are copied: the tests run without a host. -->
  <ItemGroup>
    <Reference
      Include="Turbo.Contracts"
      HintPath="$(TurboCloudPath)\Turbo.Contracts\bin\$(TurboCloudConfiguration)\net10.0\Turbo.Contracts.dll"
    />
    <Reference
      Include="Turbo.Primitives"
      HintPath="$(TurboCloudPath)\Turbo.Primitives\bin\$(TurboCloudConfiguration)\net10.0\Turbo.Primitives.dll"
    />
    <Reference
      Include="Turbo.Database"
      HintPath="$(TurboCloudPath)\Turbo.Database\bin\$(TurboCloudConfiguration)\net10.0\Turbo.Database.dll"
    />
    <Reference
      Include="Turbo.Pipeline"
      HintPath="$(TurboCloudPath)\Turbo.Pipeline\bin\$(TurboCloudConfiguration)\net10.0\Turbo.Pipeline.dll"
    />
    <Reference
      Include="Turbo.Events"
      HintPath="$(TurboCloudPath)\Turbo.Events\bin\$(TurboCloudConfiguration)\net10.0\Turbo.Events.dll"
    />
    <Reference
      Include="Turbo.Runtime"
      HintPath="$(TurboCloudPath)\Turbo.Runtime\bin\$(TurboCloudConfiguration)\net10.0\Turbo.Runtime.dll"
    />
  </ItemGroup>
</Project>
